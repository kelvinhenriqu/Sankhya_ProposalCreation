SANKHYA_BASE_URL=https://api.sankhya.com.br
SANKHYA_CLIENT_ID=replace-me
SANKHYA_CLIENT_SECRET=replace-me
SANKHYA_X_TOKEN=replace-me

SANKHYA_CONNECT_TIMEOUT=10
SANKHYA_READ_TIMEOUT=60
SANKHYA_WRITE_TIMEOUT=30
SANKHYA_POOL_TIMEOUT=10
SANKHYA_MAX_RETRIES=3
SANKHYA_RETRY_BASE_DELAY=0.5

# Opcional: sem token, o fluxo de Pipedrive fica desativado e o PDF continua normal.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN_4X=4xprocess
PIPEDRIVE_DOMAIN_JTIP=jtinstrumentacaoeprocessosindustriaisltda
# Pipeline Vendas - 4X Process. Aplicado também às propostas JTIP.
PIPEDRIVE_PIPELINE_ID=8
PIPEDRIVE_CONNECT_TIMEOUT=5
PIPEDRIVE_READ_TIMEOUT=10
PIPEDRIVE_WRITE_TIMEOUT=10

LOG_LEVEL=INFO

TEMPLATES_DIR=Templates
# Caminho no host usado pelo Docker Compose (ex.: /opt/sankhya-proposal/templates)
TEMPLATES_HOST_DIR=./Templates
PDF_CONVERTER=libreoffice
LIBREOFFICE_EXECUTABLE=
PDF_CONVERSION_TIMEOUT=120
# true: dias corridos da data da proposta ate a entrega; false: data final (DD/MM/AAAA).
DELIVERY_DEADLINE_IN_DAYS=false
# true: coloca os PDFs de escopo dos produtos antes da lista de itens.
PRODUCT_PDFS_BEFORE_ITEMS=false
